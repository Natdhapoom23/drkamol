# Postgres connection string. On Vercel, adding a Neon database sets DATABASE_URL / POSTGRES_URL automatically.
DATABASE_URI=postgresql://user:password@host:5432/drkamol
# Long random string used to sign logins. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=
# Public address of the site, e.g. https://drkamol.com
NEXT_PUBLIC_SERVER_URL=https://drkamol.com
# Set automatically when a Vercel Blob store is connected to the project (image uploads)
BLOB_READ_WRITE_TOKEN=
